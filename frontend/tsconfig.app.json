{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type safety — see docs/FRONTEND_ENGINEERING_STANDARDS.md "TypeScript".
       These four are the difference between "compiles" and "cannot be wrong at
       runtime in the ways billing code usually is wrong". */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* One alias only: `@/` is src. Everything inside a feature uses relative
       imports, so an `@/features/...` import is always a cross-feature import
       and the lint rule can see it. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
