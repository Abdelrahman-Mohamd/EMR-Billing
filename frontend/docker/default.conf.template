# The Billing frontend's server: the built app, the run-time settings, a
# health check. TLS and HSTS belong to whatever terminates HTTPS in front of
# it (docs/DEPLOYMENT.md).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # For the orchestrator's probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Written at start-up from API_BASE_URL / APP_ENVIRONMENT; never cached.
    location = /config.js {
        alias /tmp/app-config/config.js;
        default_type application/javascript;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    # Fingerprinted by the build (index-3fa9c1.js): cached for a year.
    # A missing file is a 404, never the app's HTML in its place.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Source maps are not shipped; refuse the name anyway.
    location ~* \.map$ {
        return 404;
    }

    # Every app address (/patients/12, /visits/30…) is the app itself; the
    # browser routes it. index.html is always revalidated, so a new release
    # is picked up at once.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
