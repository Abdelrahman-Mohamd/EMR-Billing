# Copy to .env (not committed) and fill in. Every VITE_* value is compiled into
# the bundle and readable by anyone using the app: nothing secret belongs here
# (docs/SECURITY.md "Environment variables"). A Docker container takes the same
# settings at run time instead (docs/DEPLOYMENT.md).

# Base URL of the Billing API, e.g. https://api.example.test/api/v1. Empty means
# no backend: every request is refused as "unavailable" without being sent.
VITE_API_BASE_URL=

# development, staging or production. Non-production names are shown in the app.
VITE_ENVIRONMENT=development
