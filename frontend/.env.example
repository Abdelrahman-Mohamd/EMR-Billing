# Every value here is shipped to the browser and is readable by anyone using the
# app. Nothing secret belongs in this file or in any VITE_* variable — see
# docs/SECURITY.md "Environment variables".
#
# Copy to .env.local (gitignored) to run locally.

# Base URL of the Billing API. Empty means "no backend yet": the app runs
# against the mock data layer. Once a backend exists this becomes e.g.
# https://api.example.com/v1
VITE_API_BASE_URL=

# "mock" until a backend exists, then "live".
VITE_DATA_SOURCE=mock

# Shown in the UI so a tester can never mistake staging for production.
VITE_ENVIRONMENT=development
