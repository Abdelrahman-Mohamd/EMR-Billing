# Every value here is shipped to the browser and is readable by anyone using the
# app. Nothing secret belongs in this file or in any VITE_* variable — see
# docs/SECURITY.md "Environment variables".
#
# `.env` (committed) already points `npm run dev` at staging. To use another
# backend on your machine, copy this file to .env.local (gitignored).

# Base URL of the Billing API. Empty means no backend: every request is refused
# as "unavailable" without being sent.
VITE_API_BASE_URL=https://api.example.test/api/v1

# Shown in the UI so a tester can never mistake staging for production.
VITE_ENVIRONMENT=staging
